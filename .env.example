# ==============================================================================
# BADRA FINTECH PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in each app or root and replace with your actual keys.
# NEVER commit your real .env file with production secrets to GitHub!

# Supabase API Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Environment (development | staging | production)
APP_ENV=development

# Edge Functions Endpoints
EDGE_FUNCTION_BASE_URL=https://your-project-ref.supabase.co/functions/v1
PROCESS_PAYMENT_URL=https://your-project-ref.supabase.co/functions/v1/process-badra-payment
REQUEST_PAYMENT_URL=https://your-project-ref.supabase.co/functions/v1/request-payment

# Security & Encryption Salts (Optional client-side HMAC signatures)
SECURITY_SALT=replace-with-your-secure-salt-phrase
